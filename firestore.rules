rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Inquiries collection: Public can submit inquiries, authenticated users can view/manage their own, admins can view all
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.email == 'hienthao.do@gmail.com');
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.email == 'hienthao.do@gmail.com');
    }

    // Public showcase data
    match /portfolioSamples/{sampleId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'hienthao.do@gmail.com';
    }

    // Default catch-all for authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'hienthao.do@gmail.com';
    }
  }
}
